# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Shared Multi-Tenant Database)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/leap?retryWrites=true&w=majority

# Tenant & Platform Auth Secrets
JWT_SECRET=your-secure-jwt-secret-for-tenant-users-minimum-32-chars
PLATFORM_JWT_SECRET=your-secure-jwt-secret-for-platform-admins-minimum-32-chars

# Multi-Tenant Encryption Key (AES-256-GCM: 32 bytes hex or base64)
# Used to encrypt sensitive tenant secrets at rest (e.g. WhatsApp credentials)
TENANT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Multi-Tenancy Host & Subdomain Settings
BASE_DOMAIN=leapgym.com

# File Storage Configuration
# Storage driver: "local" (default) or "s3"
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# S3 / Cloudflare R2 Credentials (Optional, when STORAGE_DRIVER=s3)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT=
