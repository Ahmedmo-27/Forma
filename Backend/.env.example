# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Shared Multi-Tenant Database)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/forma?retryWrites=true&w=majority

# Tenant & Platform Auth Secrets
JWT_SECRET=your-secure-jwt-secret-for-tenant-users-minimum-32-chars
PLATFORM_JWT_SECRET=your-secure-jwt-secret-for-platform-admins-minimum-32-chars

# Multi-Tenant Encryption Key (AES-256-GCM: 32 bytes hex or base64)
# Used to encrypt sensitive tenant secrets at rest (e.g. WhatsApp credentials)
TENANT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Production root domain (Railway). Documented for ops / future vanity subdomains; not used for JWT scoping.
# Testing (Render) does not need a custom domain — leave default *.onrender.com.
BASE_DOMAIN=forma-official.com

# Cloudflare R2 — account forma.gms1@gmail.com, bucket forma
# Uploads are stored only in this bucket. There is no local uploads directory.
# Dashboard -> R2 -> Manage R2 API Tokens -> token scoped to bucket forma (Object Read & Write)
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (do not append the bucket name)
# Leave R2_PUBLIC_URL empty so photos and ID scans stay behind GET /uploads
R2_ACCOUNT_ID=f7cd61e729b00936ed5f88b6833f5aa8
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=forma
R2_PUBLIC_URL=

# Payment Provider Configuration (Lifetime & Subscription Billing)
PAYMENT_PROVIDER_NAME=manual_transfer
# Production: https://www.forma-official.com/checkout (when public checkout exists)
PAYMENT_GATEWAY_URL=https://www.forma-official.com/checkout
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_IBAN=
PAYMENT_SWIFT=

# Email (optional in development — invite links are still returned in the platform console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Forma <noreply@forma-official.com>

# Browser origins for CORS and invite/password-reset links (comma-separated).
# Local: http://localhost:5173
# Production Railway (list app first; include www + apex):
# https://app.forma-official.com,https://www.forma-official.com,https://platform.forma-official.com,https://forma-official.com
# With BASE_DOMAIN set, HTTPS apex + single subdomains are also CORS-allowed as a safety net.
# Testing Render: localhost and/or preview URLs only — never production forma-official.com hosts
FRONTEND_ORIGIN=http://localhost:5173

# Platform Security & Access Control
PLATFORM_IP_ALLOWLIST=
PLATFORM_SESSION_TIMEOUT_MINUTES=60
PLATFORM_TENANT_RETENTION_DAYS=90
