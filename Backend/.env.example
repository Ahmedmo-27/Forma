# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Shared Multi-Tenant Database)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/forma?retryWrites=true&w=majority
# Pool sized for a single API replica. replicas × MONGO_MAX_POOL_SIZE must stay under Atlas connection limit.
# MONGO_MAX_POOL_SIZE=20
# MONGO_MIN_POOL_SIZE=0
# MONGO_MAX_IDLE_TIME_MS=30000
# MONGO_SOCKET_TIMEOUT_MS=45000
# MONGO_QUERY_MAX_TIME_MS=30000

# Shared rate-limit store — NOT used for now. Leave unset; keep Railway replicas=1.
# When Redis is introduced later, set REDIS_URL and isolate WhatsApp before scaling.
# REDIS_URL=

# Concurrent sharp/PDF transforms (default 3). Extra uploads wait or 503 after UPLOAD_TRANSFORM_WAIT_MS.
# UPLOAD_TRANSFORM_CONCURRENCY=3
# UPLOAD_TRANSFORM_WAIT_MS=15000

# Billing transaction timeouts (ms)
# MONGO_TXN_COMMIT_MS=10000
# MONGO_TXN_TIMEOUT_MS=15000

# HTTP server timeouts (Slowloris / hung connections). headersTimeout must exceed keepAliveTimeout.
# KEEP_ALIVE_TIMEOUT_MS=60000
# HEADERS_TIMEOUT_MS=65000
# REQUEST_TIMEOUT_MS=120000

# Outbound dependency timeouts
# BREVO_TIMEOUT_MS=15000
# R2_CONNECTION_TIMEOUT_MS=5000
# R2_REQUEST_TIMEOUT_MS=30000

# Tenant & Platform Auth Secrets
# NEVER reuse production values in test/Render/local. Tenant and platform secrets must differ.
# See docs/SECURITY_OPS_ATTESTATION.md §0.2 and §15.7.
JWT_SECRET=your-secure-jwt-secret-for-tenant-users-minimum-32-chars
PLATFORM_JWT_SECRET=your-secure-jwt-secret-for-platform-admins-minimum-32-chars

# Multi-Tenant Encryption Key (AES-256-GCM: 32 bytes hex or base64)
# Used to encrypt sensitive tenant secrets at rest (e.g. WhatsApp credentials)
TENANT_SECRET_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Production root domain (Railway). Auth cookies use Domain=.<BASE_DOMAIN> when NODE_ENV=production
# so app.* and api.* share httpOnly sessions (forma_tenant / forma_platform / forma_platform_refresh).
# Locally leave cookies host-only (no Domain) and use the Vite /api proxy so the SPA is same-origin.
# Testing (Render) does not need a custom domain — leave default *.onrender.com.
BASE_DOMAIN=forma-official.com

# Cloudflare R2 — account forma.gms1@gmail.com, bucket forma
# Uploads are stored only in this bucket. There is no local uploads directory.
# Dashboard -> R2 -> Manage R2 API Tokens -> token scoped to ONE bucket (Object Read & Write).
# Use a separate API token (and preferably bucket) per environment — never share prod keys with test.
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (do not append the bucket name)
# Leave R2_PUBLIC_URL empty so photos and ID scans stay behind GET /uploads
# Attest scoping in docs/SECURITY_OPS_ATTESTATION.md §15.3.
R2_ACCOUNT_ID=f7cd61e729b00936ed5f88b6833f5aa8
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=forma
R2_PUBLIC_URL=

# Payment Provider Configuration (Lifetime & Subscription Billing)
PAYMENT_PROVIDER_NAME=manual_transfer
# Production: https://www.forma-official.com/checkout (when public checkout exists)
PAYMENT_GATEWAY_URL=https://www.forma-official.com/checkout
PAYMENT_BANK_NAME=
PAYMENT_ACCOUNT_NAME=
PAYMENT_IBAN=
PAYMENT_SWIFT=

# Email (optional in development — invite links are still returned in the platform console)
# Authenticate forma-official.com in Brevo (DKIM on the apex, DMARC p=none).
# mail.forma-official.com is the Brevo return-path only. Do not send as @mail.forma-official.com.
# Leave BREVO_API_KEY empty locally; the mailer skips and logs instead of failing.
BREVO_API_KEY=
MAIL_FROM=Forma <noreply@forma-official.com>
# Password reset only. Falls back to MAIL_FROM when unset.
MAIL_FROM_SECURITY=Forma <security@forma-official.com>

# Browser origins for CORS and invite/password-reset links (comma-separated).
# Local: http://localhost:5173
# Production Railway (list app first; include www + apex):
# https://app.forma-official.com,https://www.forma-official.com,https://platform.forma-official.com,https://forma-official.com
# With BASE_DOMAIN set, HTTPS apex + single subdomains are also CORS-allowed as a safety net.
# Testing Render: localhost and/or preview URLs only — never production forma-official.com hosts
FRONTEND_ORIGIN=http://localhost:5173

# Logging. Log files are written to Backend/logs outside production; hosted
# platforms collect stdout instead. Set LOG_TO_FILE=true|false to override.
LOG_LEVEL=info
LOG_TO_FILE=

# Scheduled maintenance reminders (in-app notifications). Each branch with due or
# overdue items reminds eligible staff at most once per this many hours.
MAINTENANCE_REMINDER_REPEAT_HOURS=24

# How long a SIGTERM (deploy) waits for in-flight requests before exiting (ms).
SHUTDOWN_GRACE_MS=10000

# Minimum delay between WhatsApp replies sent from the inbox (ms).
WHATSAPP_REPLY_GAP_MS=3000

# Platform Security & Access Control
PLATFORM_IP_ALLOWLIST=
PLATFORM_SESSION_TIMEOUT_MINUTES=60
PLATFORM_TENANT_RETENTION_DAYS=90

# Error monitoring (optional). Leave SENTRY_DSN empty to disable. Events are tagged
# with tenant_id and request_id; cookies, auth headers and request bodies are stripped.
# Tracing + logs are enabled when DSN is set. Omit SENTRY_TRACES_SAMPLE_RATE to use
# defaults: 1.0 locally, 0.1 in production. Warn/error app logs also go to Sentry Logs.
# Release defaults to RAILWAY_GIT_COMMIT_SHA / RENDER_GIT_COMMIT when SENTRY_RELEASE is unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_RELEASE=

# Audit log retry backoff base (ms). Failed rows go to auditdeadletters and are retried hourly.
AUDIT_RETRY_BASE_MS=100
