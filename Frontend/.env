# --- Backend API (restart `npm run dev` after changing) ---
#
# Marketing (www / Plans, signup): needs /api/public/* — use LOCAL backend until Render is redeployed
# with the publicRoutes changes. Otherwise you get: "Route GET /api/public/plans not found".
BACKEND_ORIGIN=http://localhost:5000
#
# Gym app against Render test API (no marketing public routes on this deploy yet):
#BACKEND_ORIGIN=https://leap-backend-d4s3.onrender.com

# Force public www marketing funnel on localhost (restart Vite after changing)
VITE_SITE=www
