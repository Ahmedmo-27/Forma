# API origin without a trailing slash. Vite injects this at build time.
# MUST include the scheme (https:// or http://). A bare host like api.forma-official.com
# is treated as a path on the SPA and login returns 405.
# Local: http://localhost:5000
# Production Vercel build: https://api.forma-official.com (Railway)
# Testing gym app against Render: https://<service>.onrender.com — never for production builds.
# Marketing /api/public/* (Plans page) requires a backend that includes publicRoutes; redeploy Render or use local API.
# See docs/DOMAIN_NETWORKING.md
BACKEND_ORIGIN=http://localhost:5000

# Optional: force the public www marketing funnel on localhost ONLY.
# Never set VITE_SITE=www on Vercel — it used to make app.forma-official.com render marketing.
# Production hostnames (same Vercel project):
#   www.forma-official.com  → public marketing / plans / get-started
#   app.forma-official.com  → / → /login, then tenant dashboards (+ /platform)
# VITE_SITE=www
